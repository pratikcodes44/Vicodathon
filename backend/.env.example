# ─── LLM Provider Configuration ───────────────────────────────────────────
# Set LLM_PROVIDER to: groq | openai | gemini | fallback
# "fallback" skips all LLM calls and uses pre-scripted deterministic questions.
LLM_PROVIDER=groq

# ─── API Keys (set the one(s) you want to use) ───────────────────────────
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Model overrides (optional) ──────────────────────────────────────────
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash
