# ─── LLM Provider Configuration ───────────────────────────────────────────
# Set LLM_PROVIDER to: nvidia | groq | openai | gemini | fallback
# "fallback" skips all LLM calls and uses pre-scripted deterministic questions.
LLM_PROVIDER=nvidia

# ─── API Keys (set the one(s) you want to use) ───────────────────────────
NVIDIA_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ─── Model overrides (optional) ──────────────────────────────────────────
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-2.0-flash

# ─── Supabase (REQUIRED for production) ──────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Database (optional — falls back to local SQLite if unset) ───────────
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ─── CORS (comma-separated list of allowed frontend origins) ─────────────
# CORS_ORIGINS=https://your-netlify-app.netlify.app
