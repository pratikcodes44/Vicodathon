# ─── Supabase (REQUIRED) ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="your-supabase-project-url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ─── Backend API (REQUIRED for production) ────────────────────────────────
# Set NEXT_PUBLIC_API_URL to the deployed FastAPI backend URL on Render
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ─── Render Backend URL (used by Next.js rewrites at build time) ──────────
# Set BACKEND_URL to the deployed Render backend URL (e.g. https://interview-agent-backend.onrender.com)
BACKEND_URL="http://127.0.0.1:8000"
